  <Layout>
    <Page WIDTH="1200" HEIGHT="1600" PHYSICAL_IMG_NR="1" ID="page_1">
      <PrintSpace HPOS="0" VPOS="0" WIDTH="1200" HEIGHT="1600">
        <TextBlock ID="block_1" HPOS="120" VPOS="120" WIDTH="871" HEIGHT="896">
          <TextLine ID="line_1" HPOS="120" VPOS="120" WIDTH="871" HEIGHT="32">
            <String ID="string_1" HPOS="120" VPOS="120" WIDTH="871" HEIGHT="32" CONTENT="EPISTOLA PRIMA AGAPETI PAPAE I AD JUSTINIANUM. Justiniani fidei libellum," WC="1.0"/>
          </TextLine>
          <TextLine ID="line_2" HPOS="121" VPOS="152" WIDTH="799" HEIGHT="32">
            <String ID="string_2" HPOS="121" VPOS="152" WIDTH="799" HEIGHT="32" CONTENT="quatenus conformis est sacris canonibus, confirmat. Agapetus episcopus Justiniano Augusto." WC="1.0"/>
          </TextLine>
          <TextLine ID="line_3" HPOS="122" VPOS="184" WIDTH="719" HEIGHT="32">
            <String ID="string_3" HPOS="122" VPOS="184" WIDTH="719" HEIGHT="32" CONTENT="Gratulamur, venerabilis imperator, quod tanto catholicae fidei ardore succenderis, ut" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_4" HPOS="124" VPOS="216" WIDTH="799" HEIGHT="32">
            <String ID="string_4" HPOS="124" VPOS="216" WIDTH="799" HEIGHT="32" CONTENT="omnibus piissimae vitae vestrae temporibus piam sollicitudinem circa servandam augendamque" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_5" HPOS="125" VPOS="248" WIDTH="596" HEIGHT="32">
            <String ID="string_5" HPOS="125" VPOS="248" WIDTH="596" HEIGHT="32" CONTENT="Ecclesiarum concordiam clementer exhibeas, &amp; unam fidem, suaque p ̄" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_6" HPOS="126" VPOS="280" WIDTH="742" HEIGHT="32">
            <String ID="string_6" HPOS="126" VPOS="280" WIDTH="742" HEIGHT="32" CONTENT="omnia firmitate consimilem omnibus populis Christianis cupias praedicari. Nec mirum" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_7" HPOS="128" VPOS="312" WIDTH="591" HEIGHT="32">
            <String ID="string_7" HPOS="128" VPOS="312" WIDTH="591" HEIGHT="32" CONTENT="in ejusmodi clementiam vestram placita Deo cogitatione persistere, c ̄" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_8" HPOS="129" VPOS="344" WIDTH="639" HEIGHT="32">
            <String ID="string_8" HPOS="129" VPOS="344" WIDTH="639" HEIGHT="32" CONTENT="non alius imperii vestri beatior sit provectus, quam religionis augmentum." WC="1.0"/>
          </TextLine>
          <TextLine ID="line_9" HPOS="130" VPOS="376" WIDTH="619" HEIGHT="32">
            <String ID="string_9" HPOS="130" VPOS="376" WIDTH="619" HEIGHT="32" CONTENT="Quapropter libenti hoc &amp; prophetica voce cantabo: Repletum est gaudio" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_10" HPOS="130" VPOS="408" WIDTH="657" HEIGHT="32">
            <String ID="string_10" HPOS="130" VPOS="408" WIDTH="657" HEIGHT="32" CONTENT="os nostrum, &amp; lingua nostra exsultatione , quod florentissimum principatum" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_11" HPOS="131" VPOS="440" WIDTH="752" HEIGHT="32">
            <String ID="string_11" HPOS="131" VPOS="440" WIDTH="752" HEIGHT="32" CONTENT="vestrum divinis quotidie inspicimus beneficiis adornari. Cupis enim, venerabilis imperator," WC="1.0"/>
          </TextLine>
          <TextLine ID="line_12" HPOS="131" VPOS="472" WIDTH="548" HEIGHT="32">
            <String ID="string_12" HPOS="131" VPOS="472" WIDTH="548" HEIGHT="32" CONTENT="ut tuae pietatis epistolam de fidei vestrae expositione nuper ad" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_13" HPOS="132" VPOS="504" WIDTH="681" HEIGHT="32">
            <String ID="string_13" HPOS="132" VPOS="504" WIDTH="681" HEIGHT="32" CONTENT="beatae memoriae praedecessorem nostrum Joannem Romanae sedis antistitem, p ̄" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_14" HPOS="132" VPOS="536" WIDTH="734" HEIGHT="32">
            <String ID="string_14" HPOS="132" VPOS="536" WIDTH="734" HEIGHT="32" CONTENT="Hypatium atque Demetrium episcopos destinatam, &amp; a praefato praesule roboratam" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_15" HPOS="132" VPOS="568" WIDTH="765" HEIGHT="32">
            <String ID="string_15" HPOS="132" VPOS="568" WIDTH="765" HEIGHT="32" CONTENT="nostra quoque auctoritate firmemus: laudamus, amplectimur: non quia laicis auctoritatem" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_16" HPOS="132" VPOS="600" WIDTH="725" HEIGHT="32">
            <String ID="string_16" HPOS="132" VPOS="600" WIDTH="725" HEIGHT="32" CONTENT="praedicationis admittimus, sed quia studium fidei vestrae patrum nostrorum regulis" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_17" HPOS="131" VPOS="632" WIDTH="559" HEIGHT="32">
            <String ID="string_17" HPOS="131" VPOS="632" WIDTH="559" HEIGHT="32" CONTENT="conveniens confirmamus atque roboramus. p ̄ quod jam &amp; unitas" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_18" HPOS="131" VPOS="664" WIDTH="653" HEIGHT="32">
            <String ID="string_18" HPOS="131" VPOS="664" WIDTH="653" HEIGHT="32" CONTENT="provenit Ecclesiae, &amp; reliqua catholicae membra Ecclesiae ad ejus compagem" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_19" HPOS="130" VPOS="696" WIDTH="812" HEIGHT="32">
            <String ID="string_19" HPOS="130" VPOS="696" WIDTH="812" HEIGHT="32" CONTENT="Christianitatis constantia reditura confidimus. Cujus professionis vel epistolae vestrae tenorem" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_20" HPOS="130" VPOS="728" WIDTH="697" HEIGHT="32">
            <String ID="string_20" HPOS="130" VPOS="728" WIDTH="697" HEIGHT="32" CONTENT="inferius annectentes, studium, quod circa Deum integre geritis, nostra auctoritate" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_21" HPOS="129" VPOS="760" WIDTH="771" HEIGHT="32">
            <String ID="string_21" HPOS="129" VPOS="760" WIDTH="771" HEIGHT="32" CONTENT="firmamus, praedicantes hujusmodi fidem omnibus patrum nostrorum regulis convenire, &amp;" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_22" HPOS="128" VPOS="792" WIDTH="694" HEIGHT="32">
            <String ID="string_22" HPOS="128" VPOS="792" WIDTH="694" HEIGHT="32" CONTENT="apostolicae sedis concordare dogmatibus: constituentes ut si quis nostrae catholicae" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_23" HPOS="126" VPOS="824" WIDTH="681" HEIGHT="32">
            <String ID="string_23" HPOS="126" VPOS="824" WIDTH="681" HEIGHT="32" CONTENT="fidei contraire tentaverit, quam p ̄ submovenda haereticorum suspicione paternis" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_24" HPOS="125" VPOS="856" WIDTH="848" HEIGHT="32">
            <String ID="string_24" HPOS="125" VPOS="856" WIDTH="848" HEIGHT="32" CONTENT="regulis consonantem praesenti definitione firmamus, sanctae communionis efficiatur extraneus. Unde" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_25" HPOS="124" VPOS="888" WIDTH="477" HEIGHT="32">
            <String ID="string_25" HPOS="124" VPOS="888" WIDTH="477" HEIGHT="32" CONTENT="&amp; Cyrum, ejusque sequaces, jam ante p ̄ hac insania" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_26" HPOS="122" VPOS="920" WIDTH="633" HEIGHT="32">
            <String ID="string_26" HPOS="122" VPOS="920" WIDTH="633" HEIGHT="32" CONTENT="ab Ecclesiae catholicae communione suspensos, &amp; in sua hactenus perfidia" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_27" HPOS="121" VPOS="952" WIDTH="807" HEIGHT="32">
            <String ID="string_27" HPOS="121" VPOS="952" WIDTH="807" HEIGHT="32" CONTENT="permanentes, nisi sub satisfactione canonica doctrinam apostolicam fuerint consecuti, nullatenus" WC="1.0"/>
          </TextLine>
          <TextLine ID="line_28" HPOS="120" VPOS="984" WIDTH="637" HEIGHT="32">
            <String ID="string_28" HPOS="120" VPOS="984" WIDTH="637" HEIGHT="32" CONTENT="patimur eos sacrae communioni restitui: sed etiam ut haereticos anathemati" WC="1.0"/>
          </TextLine>
        </TextBlock>
      </PrintSpace>
    </Page>
  </Layout>
